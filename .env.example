# ============================================================
# 配置模板（已脱敏）
# 所有密钥/口令的取值一律以 **** 占位，请勿在此文件写入真实值。
# 使用方法：复制本文件为 .env，再把 **** 替换成你自己的凭证。
# .env 已被 .gitignore 排除，不会进入版本库。
# ============================================================

# Tushare Pro
TUSHARE_TOKEN=****
TUSHARE_POINTS=2200
TUSHARE_REQUEST_DELAY=0.25
TUSHARE_RETRY_TIMES=3

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quant_db
DB_USER=postgres
DB_PASSWORD=****

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=****

# Active diagnostic research artifact used by the Web v8 endpoints
V8_ARTIFACT_PATH=reports/ml_lab/v11_dual_artifact_feature_v2/artifact.json

# Optional, currently disabled in v1
AI_ANALYSIS_ENABLED=false
DEEPSEEK_API_KEY=****
