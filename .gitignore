# ===== 密钥与本地配置（永不入库）=====
.env
.env.*
!.env.example
*.pem
*.key

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv_broken_*/
venv/
.conda/

# ===== 测试 / 静态检查缓存 =====
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ===== IDE / 系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db

# ===== 运行产物（体积大、可重跑）=====
logs/
cache/
catboost_info/
reports/
*.log

# ===== 二进制产物与原始素材 =====
*.docx
*.xlsm
# 例外：docs/handoff/ 下是已脱敏的文档副本
!docs/handoff/*.docx
docs/_docx_extracts/
